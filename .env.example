# Arcade MCP Gateway URL — create a gateway at app.arcade.dev/mcp-gateways
# Add the PostHog toolkit to your gateway, then paste the URL here.
ARCADE_GATEWAY_URL=

# App URL — required for deployed environments so the OAuth callback works
# Set to your deployment URL (e.g. https://your-app.vercel.app)
# APP_URL=https://your-app.vercel.app

# Slack bot credentials (from your Slack app config)
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_SIGNING_SECRET=your-signing-secret

# LLM provider — set one (Anthropic takes priority if both are set)
ANTHROPIC_API_KEY=sk-ant-your-key
# OPENAI_API_KEY=sk-your-key

# Redis for production state persistence (required on Vercel/serverless)
# Without this, thread subscriptions are lost on restart and follow-up messages won't work.
# e.g. Upstash, Railway, or Vercel KV all work.
# REDIS_URL=redis://localhost:6379

# Channel allowlist — comma-separated Slack channel IDs (optional)
# If unset, bot responds in all channels it's invited to.
# ALLOWED_CHANNEL_IDS=C01234ABCDE,C05678FGHIJ
