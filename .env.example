# PostHog API key (Settings → API keys → Personal API keys)
POSTHOG_API_KEY=phx_your_api_key_here

# Override the PostHog MCP URL (optional — defaults to the URL below)
# POSTHOG_MCP_URL=https://mcp.posthog.com/sse?features=insights,dashboards,workspace,error-tracking,flags,docs

# Slack bot credentials (from your Slack app config)
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_SIGNING_SECRET=your-signing-secret

# LLM provider — set one (Anthropic takes priority if both are set)
ANTHROPIC_API_KEY=sk-ant-your-key
# OPENAI_API_KEY=sk-your-key

# Redis for production state persistence (required on Vercel/serverless)
# Without this, thread subscriptions are lost on restart and follow-up messages won't work.
# e.g. Upstash, Railway, or Vercel KV all work.
# REDIS_URL=redis://localhost:6379

# Channel allowlist — comma-separated Slack channel IDs (optional)
# If unset, bot responds in all channels it's invited to.
# ALLOWED_CHANNEL_IDS=C01234ABCDE,C05678FGHIJ
